# ─────────────────────────────────────────────────────────────
#  Ecojindu Shuttle — Operations Dashboard & Driver Portal
#  (.env.local)
#
#  This app holds no secrets. It authenticates staff against the
#  backend with a JWT and calls the same API the website uses.
# ─────────────────────────────────────────────────────────────

# ── Backend API ──────────────────────────────────────────────
# Must be reachable from the browser and listed in the backend's CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_NAME="Ecojindu Operations"

# ── Contact (shown to staff on error screens) ────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=jinduinc@gmail.com
NEXT_PUBLIC_SUPPORT_PHONE=+234 815 447 1570

# ── Operational thresholds ───────────────────────────────────
# A departure under this occupancy inside 24 hours raises a dashboard alert.
NEXT_PUBLIC_LOW_OCCUPANCY_THRESHOLD=30
